{
  "name": "suenweb",
  "version": "1.3.0",
  "description": "SuenWeb — 轻量个人导航页 (Cloudflare Workers + Python FastAPI)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "setup": "node scripts/deploy.js",
    "deploy:auto": "node scripts/deploy.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:setup:local": "wrangler d1 execute suenweb-db --local --file=./schema.sql",
    "db:setup:remote": "wrangler d1 execute suenweb-db --remote --file=./schema.sql",
    "pack:ext": "node scripts/pack-extension.mjs",
    "sync:ext": "node scripts/pack-extension.mjs",
    "build": "tsc --noEmit"
  },
  "keywords": ["navigation", "cloudflare-workers", "d1", "workers-ai"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
