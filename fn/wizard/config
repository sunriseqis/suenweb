    "stepTitle": "服务与网络",
    "items": [
      {
        "type": "tips",
        "helpText": "请设置 SuenWeb 的服务端口。浏览器与插件将通过该端口连接。升级时也可在此修改端口，修改后会自动重启服务。"
      },
      {
        "type": "text",
        "field": "wizard_port",
        "label": "服务端口",
        "initValue": "8080",
        "rules": [
          {
            "required": true,
            "message": "服务端口不能为空"
          },
          {
            "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "message": "请输入有效的端口号 (1-65535)"
          }
        ]
      }
    ]
  }
]
