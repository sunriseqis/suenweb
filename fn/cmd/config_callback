#!/bin/bash
# 设置页配置变更回调：持久化向导端口到 etc/.env，并重启服务生效。
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="${TRIM_APPDEST:-}"
VAR_DIR="${TRIM_PKGVAR:-}"
ETC_DIR="${TRIM_PKGETC:-}"
if [ -z "${APP_DIR}" ]; then APP_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"; fi
if [ -z "${VAR_DIR}" ]; then
    PKG_ROOT="$(cd "${APP_DIR}/.." && pwd)"
    VAR_DIR="${PKG_ROOT}/var"
fi
if [ -z "${ETC_DIR}" ]; then
    PKG_ROOT_ETC="$(cd "${APP_DIR}/.." && pwd)"
    ETC_DIR="${PKG_ROOT_ETC}/etc"
fi
mkdir -p "${ETC_DIR}" 2>/dev/null
LOG_FILE="${VAR_DIR}/info.log"
log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - [config_callback] $1" >> "${LOG_FILE}" 2>/dev/null; }

if [ -n "${wizard_port:-}" ]; then
    if [ -f "${ETC_DIR}/.env" ]; then
        sed -i "s/^SUENWEB_PORT=.*/SUENWEB_PORT=${wizard_port}/" "${ETC_DIR}/.env" 2>/dev/null \
            || printf 'SUENWEB_PORT=%s\n' "${wizard_port}" >> "${ETC_DIR}/.env"
    else
        printf 'SUENWEB_PORT=%s\n' "${wizard_port}" > "${ETC_DIR}/.env"
    fi
    log_msg "向导端口 ${wizard_port} 已写入 ${ETC_DIR}/.env"
fi

log_msg "配置变更，重启服务"
"${SCRIPT_DIR}/main" stop >> "${LOG_FILE}" 2>&1
"${SCRIPT_DIR}/main" start >> "${LOG_FILE}" 2>&1
exit 0
